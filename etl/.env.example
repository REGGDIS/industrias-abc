# ============================================================
# ETL - Industrias ABC
# Plantilla de configuración de fuentes operacionales
# No almacenar contraseñas reales en este archivo.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL - RRHH
# ------------------------------------------------------------
RRHH_DB_HOST=localhost
RRHH_DB_PORT=5432
RRHH_DB_NAME=industrias_abc_rrhh
RRHH_DB_USER=postgres
RRHH_DB_PASSWORD=

# ------------------------------------------------------------
# PostgreSQL - Compras
# ------------------------------------------------------------
COMPRAS_DB_HOST=localhost
COMPRAS_DB_PORT=5432
COMPRAS_DB_NAME=industrias_abc_compras
COMPRAS_DB_USER=postgres
COMPRAS_DB_PASSWORD=

# ------------------------------------------------------------
# PostgreSQL - Contabilidad
# ------------------------------------------------------------
CONTABILIDAD_DB_HOST=localhost
CONTABILIDAD_DB_PORT=5432
CONTABILIDAD_DB_NAME=industrias_abc_contabilidad
CONTABILIDAD_DB_USER=postgres
CONTABILIDAD_DB_PASSWORD=

# ------------------------------------------------------------
# MySQL - Producción
# ------------------------------------------------------------
PRODUCCION_DB_HOST=localhost
PRODUCCION_DB_PORT=3306
PRODUCCION_DB_NAME=industrias_abc_produccion
PRODUCCION_DB_USER=root
PRODUCCION_DB_PASSWORD=

# ------------------------------------------------------------
# MySQL - Asistencia
# ------------------------------------------------------------
ASISTENCIA_DB_HOST=localhost
ASISTENCIA_DB_PORT=3306
ASISTENCIA_DB_NAME=sistemadeasistenciaindustriasabc
ASISTENCIA_DB_USER=root
ASISTENCIA_DB_PASSWORD=

# ------------------------------------------------------------
# SQL Server - Contratos y Remuneraciones
# ------------------------------------------------------------
CONTRATOS_REM_DB_HOST=localhost
CONTRATOS_REM_DB_PORT=1433
CONTRATOS_REM_DB_NAME=ContratosRemuneraciones_ABC
CONTRATOS_REM_DB_USER=sa
CONTRATOS_REM_DB_PASSWORD=

# ------------------------------------------------------------
# Configuración general ETL
# ------------------------------------------------------------
ETL_ENV=development
ETL_LOG_LEVEL=INFO